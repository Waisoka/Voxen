# Clerk Auth
# NEXT_PUBLIC_* = exposed to browser; without prefix = server-side only
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=

NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=

# -----------------------------------------------------------------------------
# AI Engine / Gen CAD endpoint (Next.js API Routes proxy to this)
# Use localhost, NOT 0.0.0.0 (browser cannot connect to 0.0.0.0)
# Required by Next.js API routes. Example: http://localhost:8000/generate
# -----------------------------------------------------------------------------
AI_ENGINE_URL=

# -----------------------------------------------------------------------------
# LLM / Model settings (documented in README.md)
# -----------------------------------------------------------------------------
# Set to http://localhost:8000 for Local Model mode
# Set to https://openrouter.ai/api/v1 for OpenRouter mode
LLM_API_BASE_URL=

# OpenRouter API Key (only needed if using OpenRouter mode)
# Get yours at https://openrouter.ai
LLM_API_KEY=

# Model identifier
# Local: Qwen/Qwen2.5-7B-Instruct
# OpenRouter: qwen/qwen-2.5-7b-instruct:free
LLM_MODEL=

# Cloud AI toggle: set "true" to use OpenRouter, "false" (default) for local model
USE_CLOUD_AI=

# -----------------------------------------------------------------------------
# AI Engine model paths (Python backend - ai-engine/app.py)
# -----------------------------------------------------------------------------
BASE_MODEL_PATH=
FINETUNED_PATH=

# -----------------------------------------------------------------------------
# Fine-tuning config (ai-engine/finetune.py)
# -----------------------------------------------------------------------------
MODEL_ID=
DATASET_PATH=
OUTPUT_DIR=
LOGGING_DIR=

# -----------------------------------------------------------------------------
# AI Engine server (ai-engine/app.py uvicorn)
# -----------------------------------------------------------------------------
AI_ENGINE_HOST=
AI_ENGINE_PORT=